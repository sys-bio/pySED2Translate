{
  "version": "v1.0.0",
  "constants": {
    "t": [
      0,
      1,
      2,
      3
    ],
    "y": [
      1,
      4,
      9,
      16
    ],
    "gx": [
      0,
      1
    ],
    "gy": [
      0,
      1,
      2
    ],
    "z": [
      [
        1,
        2,
        3
      ],
      [
        4,
        5,
        6
      ]
    ]
